# ==============================================================
# SmartSight .gitignore
# ==============================================================

# ---------------------- Python ----------------------
env/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# ---------------------- Django ----------------------
# Migrations (DB is on Supabase, migrations run locally)
app/migrations/0*.py
# Keep __init__.py so Django recognizes the migrations package

# Static files collected for production
staticfiles/

# Database files
*.sqlite3

# Media uploads (user content, not source code)
/media/

# ---------------------- ML Models ----------------------
*.onnx
*.pt
*.h5
*.pb
*.tflite
app/models/*.onnx
app/models/*.pt

# ---------------------- Tools / Scripts ----------------------
tools/

# ---------------------- Deployment Plans ----------------------
DEPLOYMENT_*.md

# ---------------------- Data Dumps ----------------------
datadump.json
*.json.bak

# ---------------------- Environment & Credentials ----------------------
.env
.env.*
!.env.example
firebase-credentials.json
google-services.json
local.properties
*.keystore
*.jks

# ---------------------- Node / Frontend Build ----------------------
node_modules/
dist/
build/
.cache/
*.tsbuildinfo

# Frontend build outputs
frontend-android/dist/
frontend-android/android/.gradle/
frontend-android/android/.kotlin/
frontend-android/android/build/
frontend-android/android/app/build/
frontend-android/android/capacitor-cordova-android-plugins/build/

desktop/dist/
desktop/electron/app/
desktop/electron/dist/
desktop/electron/make/

# Lock files (regenerated from package.json)
package-lock.json
frontend-android/package-lock.json
desktop/package-lock.json
desktop/electron/package-lock.json

# ---------------------- Android APK / Build ----------------------
*.apk
*.aab
.gradle/
.kotlin/

# ---------------------- Desktop / Electron ----------------------
*.exe
*.blockmap
*.dmg
*.snap
.jdk17/

# ---------------------- IDE & OS ----------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db